doctype html
html
  head
    title= title
  body
    h1 Create a New Custom Object Record

    form(action="/update-cobj" method="POST")
      div
        label(for="brand") brand
        br
        input(type="text" name="property_1" id="property_1" required)

      br
      div
        label(for="model") model
        br
        input(type="text" name="property_2" id="property_2" required)

      br
      div
        label(for="processor") processor
        br
        input(type="text" name="property_3" id="property_3" required)

      br
      button(type="submit") Submit

    br
    a(href="/") Return to the homepage
